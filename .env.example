# Skopiuj do .env i uzupełnij. Plik .env nie trafia do repo.

# Wspólne hasło ekipy
PASSWORD=zmien-to-haslo

# Hasło admina (inne niż hasło ekipy): edycja i usuwanie wszystkiego, zmiana imion, usuwanie osób.
# Puste = tryb admina wyłączony.
ADMIN_PASSWORD=

TITLE=PGA: centrum wyjazdu

# Dni i pory dnia. Format: Dzień:pora,pora;Dzień:pora
DAYS=Piątek:rano,popołudnie,wieczór;Sobota:rano,popołudnie,wieczór;Niedziela:rano,popołudnie
